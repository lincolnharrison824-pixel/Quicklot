{
  "manifest_version": 3,
  "name": "QuickLot",
  "version": "0.2.0",
  "description": "Turn a car on your dealership's website into a Facebook Marketplace listing. You review it and click Publish.",
  "key": "",
  "action": {
    "default_title": "QuickLot",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity",
    "tabs"
  ],
  "host_permissions": [
    "https://www.genesisofconway.com/*",
    "https://www.facebook.com/*"
  ]
}
