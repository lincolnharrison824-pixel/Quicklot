# Copy to .env.local for local runs. On Vercel, add these under Project > Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
ANTHROPIC_API_KEY=your-anthropic-api-key
# Max AI-written listings per user per day (protects your AI bill).
DAILY_LISTING_LIMIT=40
# Max AI-written listings per user per calendar month.
MONTHLY_LISTING_LIMIT=400
# Which Claude model writes listings. Default claude-haiku-5-5 (cheapest); claude-opus-5-5 writes the best.
WRITER_MODEL=claude-haiku-5-5
